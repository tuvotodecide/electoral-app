# environment
ENVIRONMENT=development
APP_FLOW=voting

PRIVACY_URL=https://dev.wirawallet.com/terms
SUPPORT_EMAIL=
TERMS_URL=https://dev.wirawallet.com/privacy

# ---
CHAIN=base-sepolia
BACKEND=
BACKEND_IDENTITY=
BACKEND_RESULT=
FRONTEND_RESULTS=
BACKEND_BLOCKCHAIN=
BROADCAST_TOPIC=

# ---
# URL completa del ZIP de circuitos (AuthV2, credentialAtomicQuerySigV2,
# credentialAtomicQueryMTPV2). Cada circuito necesita <id>.wcd y <id>.zkey.
CIRCUITS_URL=https://gateway.wirawallet.com/circuits/keys.zip

# --- Privado ID SDK (Base Sepolia)
# identityApi usa BACKEND_IDENTITY e IDENTITY_KEY.
PRIVADO_BLOCKCHAIN=base
PRIVADO_NETWORK=sepolia
PRIVADO_CHAIN_ID=84532
PRIVADO_RPC_URL=https://sepolia.base.org
PRIVADO_STATE_CONTRACT_ADDRESS=0x3C9acB2205Aa72A05F6D77d708b5Cf85FCa3a896
PRIVADO_UNIVERSAL_VERIFIER_ADDRESS=0xfcc86A79fCb057A8e55C6B853dff9479C3cf607c
PRIVADO_DID_RESOLVER_URL=https://resolver.privado.id
# Issuer (opcional: sin PRIVADO_ISSUER_DID no se configura).
PRIVADO_ISSUER_DID=did:iden3:base:sepolia:2AuWA6tcbZHpNFqcU4fp34ssTgaVg3kTJSBLPL5QoN
PRIVADO_ISSUER_BASE_URL=https://issuer.wirawallet.com
# Credencial (opcional: sin PRIVADO_CRED_TYPE no se configura). URLs completas,
# a diferencia de CRED_SCHEMA_URL, que es una ruta sobre BACKEND_IDENTITY.
PRIVADO_CRED_TYPE=PersonCredential
PRIVADO_CRED_SCHEMA_URL=https://ipfs.io/ipfs/QmeQhwtwP6XNG155M49yV6TFmm6s8er13WfeU7tcuM8eat
PRIVADO_CRED_CONTEXT_URL=https://ipfs.io/ipfs/QmbaL4bG16tTYqAzn35qztT6cqTRZT1FMRfkcp5SLTDW2T
# Tipo de la credencial de identidad que emite backend-identity (obligatoria para
# iniciar sesión). Debe coincidir con ISSUER_CREDENTIAL_TYPE del backend.
PRIVADO_IDENTITY_CREDENTIAL_TYPE=PersonCredential
# Tipo de la credencial de voto que emite back-results (obligatoria para votar).
# Debe coincidir con VOTE_CRED_TYPE del backend.
PRIVADO_VOTE_CREDENTIAL_TYPE=SelectedVoter
# Gateway para contextos JSON-LD ipfs:// (opcional; por defecto https://ipfs.io/ipfs).
PRIVADO_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# Bloqueo del vault (claves privadas y credenciales). Obligatorias.
# true: se bloquea al pasar la app a segundo plano.
PRIVADO_LOCK_ON_BACKGROUND=true
# Minutos sin uso antes de bloquearse (número mayor que 0).
PRIVADO_IDLE_TIMEOUT_MINUTES=5

# URL de verificación del backend de identidad para ipfs
CRED_SCHEMA_URL=

# local api keys
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# to testing point to backend results
PINATA_API=

# ZK authentication
VERIFIER_REQUEST_ENDPOINT=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

SENTRY_DSN_KEY=
IDENTITY_KEY=

TVD_TOKEN_ADDRESS=